{
  "name": "ki-lead",
  "version": "0.5.6",
  "description": "KI-LEAD – Forschungsdemonstrator für die LEAD-Systematik (Lageerfassung, -auswertung und -darstellung)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest run tests/ui",
    "test:zufall": "vitest run --sequence.shuffle --sequence.seed=20261021",
    "test:browser": "playwright test",
    "test:browser:kern": "playwright test --project=kern",
    "test:browser:pwa": "playwright test --project=pwa",
    "test:inhalt": "vitest run tests/profil tests/kern tests/evaluation",
    "pruefe-profile": "vitest run tests/profil",
    "sop:lesefassung": "node scripts/sop-lesefassung.mjs",
    "app:sync": "vite build && cap sync",
    "app:ios": "vite build && cap sync ios && cap open ios",
    "app:android": "vite build && cap sync android && cap open android"
  },
  "author": "Heiko Pereira Wolf (https://www.pereirawolf.de)",
  "license": "EUPL-1.2",
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "idb-keyval": "^6.3.0",
    "js-yaml": "^5.5.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "jszip": "^3.10.2",
    "markdown-it": "15.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "^1.56.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module"
}

      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": ["fassung"],
        "properties": {
          "fassung": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+$"
          }

    "analyse": {
      "type": "object",
      "description": "Lesbare Analysetexte mit Belegverweisen [Qn]. Maßnahmen und Empfehlungen stehen im Handlungsbedarf.",
      "required": ["lage_ereignis", "risiken_auswirkungen", "abhaengigkeiten_interdependenzen"],

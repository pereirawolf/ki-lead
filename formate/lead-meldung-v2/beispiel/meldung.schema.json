    "sachverhalt_vollstaendig": {
      "description": "Zusatzbedingungen ab Status „zur_freigabe“.",
      "properties": {
        "kennung": {
          "$ref": "#/$defs/kennung"
        },
        "bezeichnung": {
          "type": "string",
          "pattern": "\\S"
        },

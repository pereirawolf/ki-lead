{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pereirawolf/ki-lead/formate/fremd/thessa-kennzahlen/gebuendelt/0.1.schema.json",
  "title": "Thessa – Kennzahlen-Baustein 0.1 (Entwurf)",
  "description": "Verdichtete Kräftelage eines Raums als Quellenangabe und Kennzahlen im Format von LEAD-Meldung-v2, dazu die lagerelevanten Einsatzmeldungen ohne Ortslage und ohne Freitext-Hinweise. Eine Lagemeldung übernimmt quellen und kennzahlen in einen Sachverhalt; die Kennungen Q1 und K1 … sind dabei gegebenenfalls umzunummerieren. Kennzahlen mit verschiedenen Einheiten (Einsatzmittel, Einsätze, Einsatzkräfte, Ausrückebereiche, Einheiten des Katastrophenschutzes) werden nicht addiert.",
  "$comment": "Erzeugt mit scripts/fremdschemata.mjs aus 0.2/kennzahlen-baustein.schema.json (Thessa b4344c8, SHA-256 30ea7222866a…) und formate/lead-meldung-v2/kern.schema.json (SHA-256 46158e0bf5cb…); Fassung 0.1 abgeleitet: einsatzmeldungen nicht Pflicht. Nicht von Hand ändern.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "fassung",
    "erzeugt",
    "datenstand",
    "raum",
    "fiktiv",
    "quellen",
    "kennzahlen"
  ],
  "properties": {
    "format": {
      "const": "Thessa-Kennzahlen"
    },
    "fassung": {
      "const": "0.1"
    },
    "erzeugt": {
      "$ref": "#/$defs/kern_zeitangabe"
    },
    "datenstand": {
      "$ref": "#/$defs/kern_zeitangabe"
    },
    "raum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "schluessel": {
          "type": "string"
        }
      }
    },
    "fiktiv": {
      "type": "boolean"
    },
    "quellen": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/kern_quelle"
      }
    },
    "kennzahlen": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/kern_kennzahl"
      }
    },
    "einsatzmeldungen": {
      "type": "array",
      "description": "Lagerelevante Einsatzmeldungen mit Einsatzort im Raum oder mit überörtlicher Hilfe aus dem Raum, nach Beginn geordnet. Ohne Ortslage, ohne Freitext-Hinweise, ohne Kennungen der Einsatzmittel.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "einsatzart",
          "stichwort",
          "gemeinde",
          "beginn",
          "status",
          "im_gebiet",
          "einsatzmittel"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^EM-[0-9]{8}-[A-Z0-9]{4}$"
          },
          "einsatzart": {
            "type": "string",
            "description": "Code aus katalog/einsatzarten.json."
          },
          "stichwort": {
            "type": "string",
            "maxLength": 120
          },
          "gemeinde": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "schluessel": {
                "type": "string",
                "pattern": "^16[0-9]{0,6}$"
              }
            },
            "description": "Gemeinde des Einsatzorts."
          },
          "beginn": {
            "$ref": "#/$defs/kern_zeitangabe"
          },
          "ende": {
            "$ref": "#/$defs/kern_zeitangabe"
          },
          "status": {
            "enum": [
              "laufend",
              "abgeschlossen"
            ]
          },
          "im_gebiet": {
            "type": "boolean",
            "description": "Einsatzort liegt im Raum des Bausteins. Nur solche laufenden Einsätze zählen in der Kennzahl der laufenden Einsätze (Zählregel)."
          },
          "einsatzmittel": {
            "type": "integer",
            "minimum": 0,
            "description": "Anzahl der beteiligten Einsatzmittel."
          },
          "einsatzkraefte": {
            "type": "integer",
            "minimum": 0
          },
          "betroffene": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "art",
                "anzahl"
              ],
              "properties": {
                "art": {
                  "enum": [
                    "verletzt",
                    "gerettet",
                    "evakuiert",
                    "betreut"
                  ]
                },
                "anzahl": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "ueberoertlich": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "von"
            ],
            "properties": {
              "von": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "schluessel": {
                    "type": "string",
                    "pattern": "^16[0-9]{0,6}$"
                  }
                },
                "description": "Kreis oder kreisfreie Stadt der helfenden Feuerwehr."
              }
            }
          },
          "bezug_lead": {
            "type": "string",
            "description": "Kennung des Sachverhalts der Lagemeldung, zu dem der Einsatz gehört (z. B. DE-TH-20261014-P5VN)."
          }
        }
      }
    },
    "herleitung": {
      "type": "array",
      "description": "Je Kennzahl die Kennungen der Einsatzmittel und gegebenenfalls der Einsatzmeldungen, aus denen sie entsteht (Rückverfolgbarkeit).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kennzahl",
          "einsatzmittel"
        ],
        "properties": {
          "kennzahl": {
            "type": "string",
            "pattern": "^K[1-9][0-9]*$"
          },
          "einsatzmittel": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "einsatzmeldungen": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "kern_belege": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/kern_quelle_id"
      },
      "description": "Verweise auf Einträge im Quellenverzeichnis (id)."
    },
    "kern_datum": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$",
      "description": "Kalendertag JJJJ-MM-TT."
    },
    "kern_kennzahl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "gegenstand",
        "einheit",
        "art",
        "wert",
        "mindestwert",
        "erhebung",
        "datenstand",
        "quellen"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/kern_kennzahl_id"
        },
        "gegenstand": {
          "type": "string",
          "description": "z. B. „ohne Stromversorgung“, „evakuiert“, „freie Betten Intensiv“."
        },
        "einheit": {
          "type": "string",
          "description": "Personen, Haushalte, Anschlüsse, Betten … – Einheiten nicht ineinander umetikettieren."
        },
        "art": {
          "enum": [
            "bestand",
            "kumuliert",
            "kapazitaet",
            "bedarf"
          ]
        },
        "wert": {
          "type": [
            "number",
            "null"
          ],
          "description": "Zahl oder null (unbekannt); 0 nur als belegter Nullwert."
        },
        "bandbreite": {
          "type": "object",
          "required": [
            "von",
            "bis"
          ],
          "additionalProperties": false,
          "properties": {
            "von": {
              "type": "number"
            },
            "bis": {
              "type": "number"
            }
          }
        },
        "mindestwert": {
          "type": "boolean",
          "description": "Bestätigte Mindestzahl, nicht die vollständige Zahl."
        },
        "erhebung": {
          "enum": [
            "gezaehlt",
            "amtlich_gemeldet",
            "geschaetzt",
            "hochgerechnet",
            "prognostiziert"
          ]
        },
        "raum": {
          "type": "string"
        },
        "datenstand": {
          "anyOf": [
            {
              "$ref": "#/$defs/kern_zeitangabe"
            },
            {
              "type": "null"
            }
          ]
        },
        "teilmenge_von": {
          "$ref": "#/$defs/kern_kennzahl_id"
        },
        "quellen": {
          "$ref": "#/$defs/kern_belege"
        }
      }
    },
    "kern_kennzahl_id": {
      "type": "string",
      "pattern": "^K[1-9][0-9]*$"
    },
    "kern_quelle": {
      "type": "object",
      "required": [
        "id",
        "kategorie",
        "herausgeber",
        "titel",
        "zugriff",
        "zugang"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/kern_quelle_id"
        },
        "kategorie": {
          "type": "string",
          "pattern": "^[A-Z]$",
          "description": "Quellenkategorie nach dem Kodierleitfaden des Profils (Rolle der Quelle für die verwendete Aussage); das Profil legt die zulässigen Buchstaben fest."
        },
        "herausgeber": {
          "type": "string"
        },
        "titel": {
          "type": "string"
        },
        "veroeffentlicht": {
          "anyOf": [
            {
              "$ref": "#/$defs/kern_zeitangabe"
            },
            {
              "type": "null"
            }
          ]
        },
        "url": {
          "type": "string",
          "pattern": "^https?://\\S+$"
        },
        "zugriff": {
          "anyOf": [
            {
              "$ref": "#/$defs/kern_datum"
            },
            {
              "type": "null"
            }
          ],
          "description": "Tag des Abrufs bzw. der Einsicht."
        },
        "datenstand": {
          "anyOf": [
            {
              "$ref": "#/$defs/kern_zeitangabe"
            },
            {
              "type": "null"
            }
          ],
          "description": "Stand der Angaben in der Quelle, getrennt vom Veröffentlichungsdatum."
        },
        "zugang": {
          "enum": [
            "oeffentlich",
            "paywall",
            "behoerdenintern",
            "eingangsmaterial",
            "eingangsmeldung",
            "nicht_ausgewertet",
            null
          ],
          "description": "Tatsächlicher Zugang: öffentlich, hinter Bezahlschranke, behördenintern, beigefügtes Material, Meldung einer anderen Stelle, nicht ausgewertet (davon abhängige Aussagen gelten nicht als gesichert); null = nicht angegeben."
        },
        "meldung_id": {
          "$ref": "#/$defs/kern_uuid",
          "description": "Bei Eingangsmeldungen: meldung_id der verwendeten Meldungsfassung."
        },
        "ursprung": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/kern_quelle_id"
          },
          "uniqueItems": true,
          "description": "Ursprungsquelle(n), wenn diese Quelle eine Angabe nur weiterverbreitet (z. B. Medienbericht mit Betreiberzitat). Weiterverbreitungen sind keine unabhängige Bestätigung."
        },
        "anmerkung": {
          "type": "string"
        }
      }
    },
    "kern_quelle_id": {
      "type": "string",
      "pattern": "^Q[1-9][0-9]*$"
    },
    "kern_uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "UUID in Kleinbuchstaben (empfohlen Version 7, zeitlich sortierbar)."
    },
    "kern_zeitangabe": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])(T([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d)?(Z|[+-](0\\d|1[0-4]):[0-5]\\d))?$",
      "description": "Kalendertag (JJJJ-MM-TT, Tag in der Zeitzone der Meldung) oder Zeitpunkt mit UTC-Versatz. Eine Uhrzeit steht nur, wenn sie belegt ist."
    }
  }
}

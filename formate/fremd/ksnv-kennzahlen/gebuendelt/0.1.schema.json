{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pereirawolf/ki-lead/formate/fremd/ksnv-kennzahlen/gebuendelt/0.1.schema.json",
  "title": "KSNV-Kennzahlen, Fassung 0.1 (Entwurf)",
  "description": "Bedarfslage eines Raums (Stelle der Gemeindeebene, Landkreis oder kreisfreie Stadt, Land) als Quellenangabe und Kennzahlen im Format von LEAD-Meldung-v2, als Material für ein LEAD-Lagebild (KI-LEAD). Eine Lagemeldung übernimmt quellen und kennzahlen in einen Sachverhalt; die Kennungen Q1 und K1 … sind dabei gegebenenfalls umzunummerieren. Kennzahlen mit verschiedenen Einheiten (Liter je Tag, Bedarfsträger, Anlagen, kVA, Fahrzeuge) werden nicht addiert; Diesel und Ottokraftstoff stehen getrennt.",
  "$comment": "Erzeugt mit scripts/fremdschemata.mjs aus 0.1/kennzahlen-baustein.schema.json (KSNV 2340480, SHA-256 c9ceafb0c433…) und formate/lead-meldung-v2/kern.schema.json (SHA-256 d6664f85ceb3…). Nicht von Hand ändern.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "fassung",
    "erzeugt",
    "datenstand",
    "raum",
    "fiktiv",
    "szenario",
    "quellen",
    "kennzahlen",
    "herleitung"
  ],
  "properties": {
    "format": {
      "const": "KSNV-Kennzahlen"
    },
    "fassung": {
      "const": "0.1"
    },
    "erzeugt": {
      "$ref": "#/$defs/kern_zeitangabe"
    },
    "datenstand": {
      "$ref": "#/$defs/kern_zeitangabe",
      "description": "Zeitpunkt der jüngsten einbezogenen Bedarfsmeldung"
    },
    "raum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "ebene"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "schluessel": {
          "type": "string",
          "pattern": "^16(\\d{3}|\\d{6,7})?$"
        },
        "ebene": {
          "enum": [
            "gemeinde",
            "kreis",
            "land"
          ],
          "description": "Stelle der Gemeindeebene, Landkreis oder kreisfreie Stadt, Land"
        }
      }
    },
    "fiktiv": {
      "type": "boolean"
    },
    "szenario": {
      "const": "Notbetrieb ab 72 Stunden Stromausfall"
    },
    "quellen": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/kern_quelle"
      }
    },
    "kennzahlen": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/kern_kennzahl"
      }
    },
    "herleitung": {
      "type": "array",
      "description": "Je Kennzahl die Kennungen der Bedarfsmeldungen, aus denen sie entsteht (Rückverfolgbarkeit); geht nicht an eine KI.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kennzahl",
          "bedarfsmeldungen"
        ],
        "properties": {
          "kennzahl": {
            "type": "string",
            "pattern": "^K[1-9][0-9]*$"
          },
          "bedarfsmeldungen": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^16\\d{6}-[A-Za-z0-9][A-Za-z0-9-]{1,29}-v\\d{2,}$"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "kern_belege": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/kern_quelle_id"
      },
      "description": "Verweise auf Einträge im Quellenverzeichnis (id)."
    },
    "kern_datum": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$",
      "description": "Kalendertag JJJJ-MM-TT."
    },
    "kern_kennzahl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "gegenstand",
        "einheit",
        "art",
        "wert",
        "mindestwert",
        "erhebung",
        "datenstand",
        "quellen"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/kern_kennzahl_id"
        },
        "gegenstand": {
          "type": "string",
          "description": "z. B. „ohne Stromversorgung“, „evakuiert“, „freie Betten Intensiv“."
        },
        "einheit": {
          "type": "string",
          "description": "Personen, Haushalte, Anschlüsse, Betten … – Einheiten nicht ineinander umetikettieren."
        },
        "art": {
          "enum": [
            "bestand",
            "kumuliert",
            "kapazitaet",
            "bedarf"
          ]
        },
        "wert": {
          "type": [
            "number",
            "null"
          ],
          "description": "Zahl oder null (unbekannt); 0 nur als belegter Nullwert."
        },
        "bandbreite": {
          "type": "object",
          "required": [
            "von",
            "bis"
          ],
          "additionalProperties": false,
          "properties": {
            "von": {
              "type": "number"
            },
            "bis": {
              "type": "number"
            }
          }
        },
        "mindestwert": {
          "type": "boolean",
          "description": "Bestätigte Mindestzahl, nicht die vollständige Zahl."
        },
        "erhebung": {
          "enum": [
            "gezaehlt",
            "amtlich_gemeldet",
            "geschaetzt",
            "hochgerechnet",
            "prognostiziert"
          ]
        },
        "raum": {
          "type": "string"
        },
        "datenstand": {
          "anyOf": [
            {
              "$ref": "#/$defs/kern_zeitangabe"
            },
            {
              "type": "null"
            }
          ]
        },
        "teilmenge_von": {
          "$ref": "#/$defs/kern_kennzahl_id"
        },
        "quellen": {
          "$ref": "#/$defs/kern_belege"
        }
      }
    },
    "kern_kennzahl_id": {
      "type": "string",
      "pattern": "^K[1-9][0-9]*$"
    },
    "kern_quelle": {
      "type": "object",
      "required": [
        "id",
        "kategorie",
        "herausgeber",
        "titel",
        "zugriff",
        "zugang"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/kern_quelle_id"
        },
        "kategorie": {
          "type": "string",
          "pattern": "^[A-Z]$",
          "description": "Quellenkategorie nach dem Kodierleitfaden des Profils (Rolle der Quelle für die verwendete Aussage); das Profil legt die zulässigen Buchstaben fest."
        },
        "herausgeber": {
          "type": "string"
        },
        "titel": {
          "type": "string"
        },
        "veroeffentlicht": {
          "anyOf": [
            {
              "$ref": "#/$defs/kern_zeitangabe"
            },
            {
              "type": "null"
            }
          ]
        },
        "url": {
          "type": "string",
          "pattern": "^https?://\\S+$"
        },
        "zugriff": {
          "anyOf": [
            {
              "$ref": "#/$defs/kern_datum"
            },
            {
              "type": "null"
            }
          ],
          "description": "Tag des Abrufs bzw. der Einsicht."
        },
        "datenstand": {
          "anyOf": [
            {
              "$ref": "#/$defs/kern_zeitangabe"
            },
            {
              "type": "null"
            }
          ],
          "description": "Stand der Angaben in der Quelle, getrennt vom Veröffentlichungsdatum."
        },
        "zugang": {
          "enum": [
            "oeffentlich",
            "paywall",
            "behoerdenintern",
            "betriebsintern",
            "eingangsmaterial",
            "eingangsmeldung",
            "nicht_ausgewertet",
            null
          ],
          "description": "Tatsächlicher Zugang: öffentlich, hinter Bezahlschranke, behördenintern, betriebsintern (nicht öffentliche Unterlagen eines Betreibers, die die meldende Stelle selbst führt), beigefügtes Material, Meldung einer anderen Stelle, nicht ausgewertet (davon abhängige Aussagen gelten nicht als gesichert); null = nicht angegeben."
        },
        "meldung_id": {
          "$ref": "#/$defs/kern_uuid",
          "description": "Bei Eingangsmeldungen: meldung_id der verwendeten Meldungsfassung."
        },
        "ursprung": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/kern_quelle_id"
          },
          "uniqueItems": true,
          "description": "Ursprungsquelle(n), wenn diese Quelle eine Angabe nur weiterverbreitet (z. B. Medienbericht mit Betreiberzitat). Weiterverbreitungen sind keine unabhängige Bestätigung."
        },
        "anmerkung": {
          "type": "string"
        }
      }
    },
    "kern_quelle_id": {
      "type": "string",
      "pattern": "^Q[1-9][0-9]*$"
    },
    "kern_uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "UUID in Kleinbuchstaben (empfohlen Version 7, zeitlich sortierbar)."
    },
    "kern_zeitangabe": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])(T([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d)?(Z|[+-](0\\d|1[0-4]):[0-5]\\d))?$",
      "description": "Kalendertag (JJJJ-MM-TT, Tag in der Zeitzone der Meldung) oder Zeitpunkt mit UTC-Versatz. Eine Uhrzeit steht nur, wenn sie belegt ist."
    }
  }
}
